# ==============================================================================
# Autonomous arXiv Research Assistant - Environment Configuration Template
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Relational Metadata Storage
# Options: "sqlite" (default zero-dependency) or "postgresql"
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./data/metadata.db
# POSTGRES_DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/rag_db

# Vector Storage Engine
# Options: "opensearch" (Aiven Cloud or self-hosted) or "memory" (zero-dependency local fallback)
VECTOR_STORE_TYPE=opensearch
OPENSEARCH_HOST=https://your-user:your-password@your-opensearch-cluster.aivencloud.com:14442
OPENSEARCH_INDEX_NAME=arxiv_papers_hybrid
OPENSEARCH_VERIFY_CERTS=true

# Primary LLM Provider (Groq Cloud - Fast Inference)
# Options: "groq" (Recommended), "ollama" (Local), or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# Local Ollama Fallback (if using LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Dense Vector Embeddings (Jina Cloud Embeddings v3 - 1024 dimensions)
JINA_API_KEY=your_jina_api_key_here
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=1024

# Caching Layer (In-Memory or Redis)
CACHE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# Langfuse Observability & Tracing (Optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram Bot Interface (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Agentic RAG & Hybrid Retrieval Parameters
TOP_K=5
USE_HYBRID_SEARCH=true
MAX_RETRIEVAL_ATTEMPTS=2
GUARDRAIL_THRESHOLD=70
